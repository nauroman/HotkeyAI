<UserControl x:Class="HotkeyAI.Views.ProvidersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:HotkeyAI.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,12,12,12" MaxWidth="820" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Default provider" Style="{StaticResource Label}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ProviderChoices}" DisplayMemberPath="Title"
                                  SelectedValuePath="Value" SelectedValue="{Binding Model.DefaultProvider}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Actions use this provider unless you pick another one for a specific action." />
                </StackPanel>
            </Border>

            <!-- ChatGPT -->
            <Border Style="{StaticResource Card}" DataContext="{Binding Model.ChatGPT}">
                <StackPanel>
                    <TextBlock Text="ChatGPT — sign in with your account" Style="{StaticResource SectionTitle}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Account" Style="{StaticResource Label}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    Visibility="{Binding Phase, Converter={StaticResource Is}, ConverterParameter=SignedOut}">
                            <Button Content="Sign in with ChatGPT…" Click="SignIn_Click" Style="{DynamicResource AccentButtonStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    Visibility="{Binding Phase, Converter={StaticResource Is}, ConverterParameter=WaitingForBrowser}">
                            <TextBlock Text="Finish signing in in your browser…" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Content="Cancel" Click="CancelSignIn_Click" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    Visibility="{Binding Phase, Converter={StaticResource Is}, ConverterParameter=SignedIn}">
                            <TextBlock Text="{Binding Email, TargetNullValue='Signed in'}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Content="Sign out" Click="SignOut_Click" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Visibility="{Binding Phase, Converter={StaticResource Is}, ConverterParameter=SignedIn}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Plan usage" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="1" Text="✓ Allowed" Style="{StaticResource Success}"
                                       Visibility="{Binding PlanUsageGranted, Converter={StaticResource Visible}}" />
                            <Button Grid.Column="1" Content="Allow plan usage…" Click="AllowPlan_Click" HorizontalAlignment="Left"
                                    Visibility="{Binding PlanUsageGranted, Converter={StaticResource Hidden}}" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Default model" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,6,12,0" />
                            <v:ModelPicker x:Name="ChatGPTModel" Grid.Column="1" Hint="Used by actions that don't name a model." />
                        </Grid>
                        <TextBlock>
                            <Hyperlink Click="ManageUsage_Click">Manage HotkeyAI's usage limit on chatgpt.com</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding LastError}" Style="{StaticResource Error}"
                               Visibility="{Binding LastError, Converter={StaticResource Present}}" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Uses your ChatGPT Plus or Pro plan instead of an API key. You choose how much of your weekly usage HotkeyAI may spend." />
                </StackPanel>
            </Border>

            <v:ApiKeyCard Kind="OpenAI" Title="OpenAI API"
                          Footer="Billed per request to your OpenAI Platform account, separately from ChatGPT." />
            <v:ApiKeyCard Kind="Anthropic" Title="Claude (Anthropic)"
                          Footer="Anthropic doesn't allow other apps to sign in with a Claude Pro/Max subscription, so Claude needs an API key." />
            <v:ApiKeyCard Kind="Gemini" Title="Google Gemini"
                          Footer="Google AI Studio issues free keys with a daily limit." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
