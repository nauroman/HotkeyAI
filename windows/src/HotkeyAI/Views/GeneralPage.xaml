<UserControl x:Class="HotkeyAI.Views.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,12,12,12" MaxWidth="820" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Startup" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="StartupBox" Content="Open HotkeyAI when you sign in to Windows" Click="Startup_Click" />
                    <StackPanel x:Name="StartupBlocked" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="StartupBlockedText" Style="{StaticResource Warning}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Button Content="Open Startup apps" Click="OpenStartupSettings_Click" />
                    </StackPanel>
                    <TextBlock x:Name="StartupError" Style="{StaticResource Error}" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Feedback" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="Show a progress banner while working" IsChecked="{Binding ShowHud}" />
                    <TextBlock Style="{StaticResource Caption}" Text="Errors are always shown." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="How HotkeyAI works with other apps" Style="{StaticResource SectionTitle}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="When you press one of your shortcuts, HotkeyAI presses Ctrl+A (or uses your selection), Ctrl+C and Ctrl+V for you in the field you are typing in, then puts your clipboard back the way it was. It does not read your screen or record your typing." />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="The result HotkeyAI pastes is kept out of clipboard history (Win+V). The text copied from your field may appear there, as with any copy." />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Windows doesn't let apps type into programs running as administrator, so HotkeyAI can't change text there." />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="The HotkeyAI icon is in the notification area of the taskbar; it may be hidden under ^. Right-click it to run an action or quit." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="VersionText" />
                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Your text is sent only to the AI provider chosen for the action. API keys and sign-in tokens are encrypted for your Windows account and stay on this PC. HotkeyAI has no servers, analytics or ads." />
                    <TextBlock Margin="0,8,0,0">
                        <Hyperlink Click="Privacy_Click">Privacy policy</Hyperlink>
                        <Run Text="  ·  " />
                        <Hyperlink Click="Source_Click">Source code</Hyperlink>
                        <Run Text="  ·  " />
                        <Hyperlink Click="Issues_Click">Report a problem</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
