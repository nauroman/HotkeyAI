<UserControl x:Class="HotkeyAI.Views.ApiKeyCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:HotkeyAI.Views">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" />
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="API key" Style="{StaticResource Label}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            Visibility="{Binding KeySaved, Converter={StaticResource Visible}}">
                    <TextBlock Text="Saved, encrypted for your Windows account" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button Content="Remove" Click="Remove_Click" />
                </StackPanel>
                <DockPanel Grid.Column="1" Visibility="{Binding KeySaved, Converter={StaticResource Hidden}}">
                    <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save" Margin="8,0,0,0" Click="Save_Click" />
                    <PasswordBox x:Name="KeyBox" PasswordChanged="KeyBox_PasswordChanged" KeyDown="KeyBox_KeyDown" />
                </DockPanel>
            </Grid>
            <Grid Style="{StaticResource Row}" Visibility="{Binding KeySaved, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Default model" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,6,12,0" />
                <v:ModelPicker x:Name="Picker" Grid.Column="1" Text="{Binding DefaultModel}" />
            </Grid>
            <TextBlock>
                <Hyperlink x:Name="KeyLink" Click="KeyLink_Click"><Run x:Name="KeyLinkText" /></Hyperlink>
            </TextBlock>
            <TextBlock x:Name="FooterText" Style="{StaticResource Caption}" />
        </StackPanel>
    </Border>
</UserControl>
